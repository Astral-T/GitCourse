# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno para el servidor
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# Puerto del servidor (Render/Railway lo sobreescribe automáticamente)
PORT=3000

# ── Opción A: Cadena de conexión completa (recomendada para Supabase / Render) ──
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.XXXX.supabase.co:5432/postgres

# ── Opción B: Variables individuales (desarrollo local con PostgreSQL propio) ──
# Comenta DATABASE_URL y descomenta estas líneas si usas Postgres local:
# PGUSER=postgres
# PGPASSWORD=tu_password_local
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=piloto_curiosidad

# CORS — URL pública del frontend en producción
# Ej: https://piloto-antigravity.onrender.com
ALLOWED_ORIGIN=https://TU_DOMINIO_FRONTEND.onrender.com
